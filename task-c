import java.util.Scanner;
public class taskf {
    public static void main(String[] args){
        Scanner scanner=new Scanner(System.in);
        String pattern=scanner.nextLine();
        String input=scanner.nextLine();
        StringBuilder result = match(input.toCharArray(),pattern.toCharArray());
        System.out.print(result);
    }
    public static StringBuilder match(char[]text,char[]pattern){
        char[]newString=new char[pattern.length+text.length+1];
        int i=0;
        for(int j=0;j<pattern.length;j++){
            newString[i]=pattern[j];
            i++;
        }
        newString[i]='$';
        i++;
        for(int j=0;j<text.length;j++){
            newString[i]=text[j];
            i++;
        }
        int[]z=zfunction(newString);
        StringBuilder result=new StringBuilder();
        for (i=0;i<z.length;i++) {
            if (z[i]==pattern.length){
                result.append(i-pattern.length-1).append(' ');
            }
        }
        return result;
    }
    public static int[] zfunction(char[] input){
        int[]z=new int[input.length];
        int l=0;
        int r=0;
        for(int k=1;k<input.length;k++) {
            if(k>r) {
                l=k ;
                r=k;
                while(r<input.length && input[r]==input[r-l]){
                    r++;
                }
                z[k]=r-l;
                r--;
            }
            else {
                int k1=k-l;
                if(z[k1]<r-k+1) {
                    z[k]=z[k1];
                }
                else{
                    l=k;
                    while(r< input.length && input[r]==input[r-l]) {
                        r++;
                    }
                    z[k]=r-l;
                    r--;
                }
            }
        }
        return z;
    }
}
